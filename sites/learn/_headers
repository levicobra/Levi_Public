# Cloudflare Pages reads this file. Max 100 rules, 2000 chars per header.
#
# This origin is a PWA, so it has two rules the other two do not: the service
# worker must never be cached, and worker-src has to be allowed.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# A cached service worker is a site that can never be updated again. The
# browser revalidates sw.js on every load; if this is ever given a max-age,
# readers stay pinned to whatever version they first installed.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# The service worker manages its own copies of these, so the HTTP cache only
# has to cover the first visit and readers with the worker disabled.
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400
/content/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
