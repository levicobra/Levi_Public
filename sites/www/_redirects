# Cloudflare Pages reads this file. Max 2100 static rules, 100 dynamic.
#
# These are not optional cleanup. Every old path below is in the README, in
# things already printed, or in whatever anyone has bookmarked or linked. 301
# so search engines transfer the ranking rather than treating it as a new page.
#
# The bare path needs its own rule in each pair: /military-benefits/* matches
# the trailing slash and anything deeper, but not /military-benefits alone.

# The benefits directory moved to its own origin.
/military-benefits      https://mil.xplabs.us/          301
/military-benefits/*    https://mil.xplabs.us/:splat    301

# /personal/ was renamed /about/ when the root became a company hub.
/personal               /about/                         301
/personal/*             /about/:splat                   301

# Retired service URLs now lead to the manufacturing-only company offering.
/engineering            /additive-manufacturing/         301
/engineering/*          /additive-manufacturing/         301
/consulting             /additive-manufacturing/         301
/consulting/*           /additive-manufacturing/         301
/rf                     /additive-manufacturing/         301
/rf/*                   /additive-manufacturing/         301
/software               /additive-manufacturing/         301
/software/*             /additive-manufacturing/         301
